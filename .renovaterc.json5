{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#11.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#11.0.0",
    "local>mortebrume/homelab//.renovate/autoMerge.json5",
    "local>mortebrume/homelab//.renovate/changelogs.json5",
    "local>mortebrume/homelab//.renovate/customManagers.json5",
    "local>mortebrume/homelab//.renovate/grafana.json5",
    "local>mortebrume/homelab//.renovate/groups.json5",
    "local>mortebrume/homelab//.renovate/labels.json5",
    "local>mortebrume/homelab//.renovate/overrides.json5",
    ":automergePr",
    ":semanticCommits",
    ":timezone(Europe/Paris)",
  ],
  dependencyDashboard: {
    title: "Renovate Dashboard",
  },
  rebaseWhen: "conflicted",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [],
  "helm-values": {
    managerFilePatterns: ["/(^|/)helmRelease\\.ya?ml(?:\\.j2)?$/"],
  },
}
