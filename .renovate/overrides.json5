{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/mortebrume/discopol"],
      enabled: false,
    },
    {
      description: "Reloader chart releases are tagged chart-vX.Y.Z",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/stakater/charts/reloader"],
      extractVersion: "^(?:chart-v)?(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      description: "Helmfile OCI charts are charts, not container images",
      matchManagers: ["helmfile"],
      matchDatasources: ["docker"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      description: "Workflows run on Forgejo Actions",
      matchManagers: ["github-actions"],
      semanticCommitScope: "forgejo-action",
    },
  ],
}
