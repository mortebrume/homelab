{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Source URL for images without an OCI source label",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^ghcr\\.io\\/stacklok\\/toolhive\\//"],
      sourceUrl: "https://github.com/stacklok/toolhive",
    },
    {
      description: "Source URL for images without an OCI source label",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kanidm/server"],
      sourceUrl: "https://github.com/kanidm/kanidm",
    },
    {
      description: "Source URL for images inheriting a Chainguard base-image label",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/techarohq/anubis"],
      sourceUrl: "https://github.com/TecharoHQ/anubis",
    },
    {
      description: "Source URL for images pointing at their packaging repo",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jellyfin/jellyfin"],
      sourceUrl: "https://github.com/jellyfin/jellyfin",
    },
    {
      description: "Source URL for charts pointing at the app repo instead of the chart repo",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/coredns/charts/coredns"],
      sourceUrl: "https://github.com/coredns/helm",
    },
    {
      description: "Chart changelog lives in a subdirectory; release tags are prefixed and don't match the mirrored package name",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/charts-mirror/external-dns"],
      sourceUrl: "https://github.com/kubernetes-sigs/external-dns",
      sourceDirectory: "charts/external-dns",
    },
    {
      description: "Changelog lives in a monorepo subdirectory; release tags are scoped npm names",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/stacklok/dockyard/npx/context7"],
      sourceUrl: "https://github.com/upstash/context7",
      sourceDirectory: "packages/mcp",
    },
    {
      description: "Source URL for images pointing at the app repo instead of the image repo",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/apache/tika"],
      sourceUrl: "https://github.com/apache/tika-docker",
    },
    {
      description: "Source URL for images pointing at their packaging repo",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/m00nwtchr/timescaledb"],
      sourceUrl: "https://github.com/timescale/timescaledb",
    },
    {
      description: "Source URL for charts without a source",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/grafana/helm-charts/grafana-operator"],
      sourceUrl: "https://github.com/grafana/grafana-operator",
    },
    {
      description: "Source URL for images without an OCI source label",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/element-hq/lk-jwt-service"],
      sourceUrl: "https://github.com/element-hq/lk-jwt-service",
    },
    {
      description: "Source URL for images without an OCI source label",
      matchDatasources: ["docker"],
      matchPackageNames: ["dock.mau.dev/mautrix/slack"],
      sourceUrl: "https://github.com/mautrix/slack",
    },
  ],
}
